# .env - общие переменные для проекта

# Docker
DOCKER=true
API_URL=http://api:8000

# Локальный запуск (можно через .env.local)
# DOCKER=false
# API_URL=http://localhost:8000

# API
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://api:8000

# Фронт (Streamlit)
FRONT_HOST=0.0.0.0
FRONT_PORT=8501

# Логи
LOG_LEVEL=info

# Пример ключей/конфигурации (можно расширить)
API_KEY=changeme
DEBUG=True

DB_URL=sqlite:///./app.db
DATABASE_URL = postgresql://user:password@postgres:5432/mydb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mydb